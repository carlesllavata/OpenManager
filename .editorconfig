# OPEN3D common editor settings. This file is the same in every OPEN3D repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows scripts use CRLF.
[*.{bat,cmd}]
end_of_line = crlf

# Windows PowerShell reads a script without a BOM as ANSI, not as UTF-8.
[*.ps1]
end_of_line = crlf
charset = utf-8-bom

# 3ds Max does not read a script without a BOM as UTF-8 either.
[*.{ms,mcr}]
charset = utf-8-bom

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

# Not decided yet (design system).
[*.{html,css,js}]
indent_style = unset
indent_size = unset
